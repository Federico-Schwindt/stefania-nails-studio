# Neon: conexión del DUEÑO de la base. Sólo para scripts locales (nunca va al navegador).
DATABASE_URL=postgresql://neondb_owner:...@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Las genera `npm run db:setup` y las escribe en .env.local:
# STUDIO_WEB_PASSWORD=...   contraseña del rol web restringido
# VITE_NEON_URL=...         conexión pública del rol web (la usa el sitio)
# ADMIN_PASSWORD=...        contraseña inicial del panel (cambiala desde Ajustes)
